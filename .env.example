PORT=3000
DRIVE_FOLDER_ID=paste_the_folder_id_here
CSV_FILE_NAME=food_bills.csv

# Google OAuth desktop/web app credentials from Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret

# Optional values
# Folder OCR-uploaded images are saved to. Defaults to DRIVE_FOLDER_ID if unset.
# OCR_DRIVE_FOLDER_ID=paste_a_different_folder_id_here
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback
# GOOGLE_OAUTH_TOKEN_FILE=./oauth-token.json
# Refresh token used when the token file is missing (set this on Render, whose disk is
# wiped on restart). Copy it from your local oauth-token.json after connecting once:
#   node -p "require('./oauth-token.json').refresh_token"
# GOOGLE_OAUTH_REFRESH_TOKEN=1//0g...
# Gmail search query used to find Zomato order emails (adjust if yours look different)
# ZOMATO_GMAIL_QUERY=(from:zomato.com OR subject:zomato) has:attachment filename:pdf
# ZOMATO_GMAIL_SYNCED_FILE=./zomato-gmail-synced.json
# ZOMATO_COMPLETED_DAYS_FILE=./zomato-completed-days.json
# Skip syncing further Zomato orders for a date once its total already saved bills reach this amount
# DAILY_REIMBURSEMENT_CAP=300

# ---- Telugu Bible reader (/bible.html) ----
# Gemini API key for the "Pastor" AI help (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash
# Highlights, reading progress, journal and memory cards are stored here
# BIBLE_DATA_FILE=./bible-data.json
# While Google is connected the same data is also kept in Google Drive (survives Render restarts)
# BIBLE_DRIVE_FOLDER_ID=defaults_to_DRIVE_FOLDER_ID
# BIBLE_DRIVE_FILE_NAME=bible-data.json
# Require this access code for the Bible API (recommended if the server is reachable beyond your LAN)
# BIBLE_ACCESS_TOKEN=choose-a-long-random-code
# Limits on Gemini calls: per device per minute, and total per day
# BIBLE_AI_PER_MINUTE=10
# BIBLE_AI_PER_DAY=150
